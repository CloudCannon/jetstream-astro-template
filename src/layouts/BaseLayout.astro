---
import { ClientRouter } from "astro:transitions";
import { fade } from "astro:transitions";
import SeoHead from "@components/utils/SeoHead.astro";
import StructuredData from "@components/utils/StructuredData.astro";
import { defaultLocale, localeCodes } from "@component-utils/locales";
import seoData from "@data/seo.json";
import "@styles/style.css";
import SiteFonts from "@layouts/SiteFonts.astro";
import VideoElements from "@components/utils/VideoElements.astro";

export interface Props {
  title?: string | null;
  description?: string | null;
  keywords?: string[] | null;
  image?: string | null;
  canonical?: string | null;
  type?: "website" | "article";
  article?: {
    publishedTime?: string | null;
    modifiedTime?: string | null;
    author?: string | string[] | null;
    tags?: string[] | null;
  } | null;
  noindex?: boolean;
  roseyRoot?: string;
  // Opt-in per page, never a default: pages whose head comes from translated content
  // must not have head keys, since a Rosey value would override it.
  roseySeo?: boolean;
  // For routes serving many pages from one template, where the derived root would
  // collapse every page onto a single key.
  roseyTitleKey?: string;
  roseyDescriptionKey?: string;
  hideLocaleSwitcher?: boolean;
}

const props = Astro.props;
const pageRoseyRoot = props.roseyRoot ?? (Astro.url.pathname.replace(/^\/|\/$/g, "") || "index");
const titleKey =
  props.roseyTitleKey ?? (props.roseySeo ? `${pageRoseyRoot}:page_title` : undefined);
const descriptionKey =
  props.roseyDescriptionKey ?? (props.roseySeo ? `${pageRoseyRoot}:page_description` : undefined);

// Excluding every locale is how the connector is told to hide its locale switcher.
// Astro drops the attribute when this is undefined, so other pages are untouched.
const rccExclude = props.hideLocaleSwitcher ? localeCodes.join(",") : undefined;
---

<!doctype html>
<html
  lang={defaultLocale}
  data-theme="light"
>
  <head>
    <meta charset="UTF-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, viewport-fit=cover"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon.svg"
    />
    <meta
      name="generator"
      content={Astro.generator}
    />
    <style is:inline>
      @layer reset, base, components, page-sections, utils, overrides;
    </style>

    <SiteFonts />

    {
      import.meta.env.DEV ? (
        <script
          type="module"
          src="/@vite/client"
        />
      ) : null
    }

    <!-- Preload fonts -->
    <link
      rel="preload"
      href="/fonts/Inter/inter-v20-latin-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/JetBrains Mono/jetbrains-mono-v24-latin-regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    <script>
      if (window.inEditorMode) {
        import("../../live-editing");
        import("../../editor-live-sync");
      }
    </script>

    {
      /* SeoHead renders the only <title> and meta description, so the Rosey keys go on
        its own tags rather than a second copy emitted here. OG and Twitter text stays
        in the default language. */
    }
    <SeoHead
      site={seoData}
      title={props.title}
      description={props.description}
      keywords={props.keywords}
      image={props.image}
      canonical={props.canonical}
      type={props.type}
      article={props.article}
      noindex={props.noindex}
      roseyTitleKey={titleKey}
      roseyDescriptionKey={descriptionKey}
    />

    <StructuredData site={seoData} />

    <link
      rel="sitemap"
      type="application/xml"
      title="Sitemap"
      href="/sitemap-index.xml"
    />

    <slot name="head" />
    <ClientRouter />
  </head>
  <body>
    {
      /* The connector's snapshot boundary. It wraps the nav and footer as well as <main>
        so they take part in locale switching — the default boundary is <main> alone.
        Shares the element with the view-transition wrapper: a nested div would put the
        transition scope inside the boundary the connector clones on locale switch. */
    }
    <div
      data-rcc
      data-rcc-exclude={rccExclude}
      transition:animate={fade({ duration: "0.2s" })}
    >
      <slot />
    </div>
    <VideoElements />
    {
      /* Loaded only in the editor — outside it the connector has nothing to do, and its
        UI would show up on the live site. */
    }
    <script>
      if (window?.inEditorMode) {
        import("rosey-cloudcannon-connector");
      }
    </script>
  </body>
</html>
