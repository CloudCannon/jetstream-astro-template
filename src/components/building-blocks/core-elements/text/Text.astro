---
import { isEditable } from "@component-utils/editable";
import { resolveRosey } from "@component-utils/roseyKey";
import markdownit from "markdown-it";

const md = markdownit({ html: true });

const {
  text = "",
  size,
  alignmentHorizontal = "start",
  class: className,
  useDefaultEditableBinding,
  "data-prop": customDataProp,
  "data-rosey": roseyId,
  _uuid,
  _component,
  ...htmlAttributes
} = Astro.props;

const markdownContent = text ? md.render(text) : "";

const isContentBlock = isEditable(Astro.props);
const effectiveDataProp = customDataProp ?? (isContentBlock ? "text" : null);
// data-type must match the rendered richness — md.render() emits block-level HTML.
// Omitting it defaults to "span", so CloudCannon would edit the raw markdown source
// while Rosey captured the rendered HTML, flagging every field permanently stale.
const textDataAttributes = effectiveDataProp
  ? { "data-editable": "text", "data-type": "block", "data-prop": effectiveDataProp }
  : {};
// Kept separate from textDataAttributes so an explicit key still lands on
// non-editable text, which has no data-prop to derive from.
const roseyAttributes = resolveRosey(roseyId, effectiveDataProp);

const hasText = text?.trim().length > 0;
const hasSlotContent = Astro.slots.has("default");

if (!_component && !hasText && !hasSlotContent) return;
---

{
  /* Without this, sibling blocks share one "text" key. It needs a holder of its own: the
  root is the region element, which a re-render copies into, and .text-inner is the
  tagged element. */
}
<div
  class:list={["text", className]}
  {...htmlAttributes}
>
  <div
    class="text-ns"
    data-rosey-ns={_uuid}
  >
    <div
      class:list={["text-inner", size && `size-${size}`, `align-${alignmentHorizontal}`]}
      {...textDataAttributes}
      {...roseyAttributes}
    >
      <slot>
        {text && <Fragment set:html={markdownContent} />}
      </slot>
    </div>
  </div>
</div>

<style is:global>
  @layer components {
    .text {
      margin-top: var(--spacing-lg);

      /* Namespace holder — must not add a box. */
      > .text-ns {
        display: contents;
      }

      .text-inner {
        &.size-xs {
          --text-size: var(--font-size-xs);
        }
        &.size-sm {
          --text-size: var(--font-size-sm);
        }
        &.size-md {
          --text-size: var(--font-size-md);
        }
        &.size-lg {
          --text-size: var(--font-size-lg);
        }
        &.size-xl {
          --text-size: var(--font-size-xl);
        }
        &.size-2xl {
          --text-size: var(--font-size-2xl);
        }
        &.size-3xl {
          --text-size: var(--font-size-3xl);
        }
        &.size-4xl {
          --text-size: var(--font-size-4xl);
        }

        > p {
          font-size: var(--text-size, inherit);
        }

        > ul {
          font-size: var(--text-size, inherit);
        }

        > ol {
          font-size: var(--text-size, inherit);
        }

        > *:first-child {
          margin-top: 0 !important;
        }

        > *:last-child {
          margin-bottom: 0 !important;
        }

        &.align-start {
          text-align: start;
        }

        &.align-center {
          text-align: center;
        }

        &.align-end {
          text-align: end;
        }
      }
    }
  }
</style>
