---
import { resolveRosey } from "@component-utils/roseyKey";
import MarkdownIt from "markdown-it";

const {
  text,
  size = "md",
  alignmentHorizontal = "start",
  class: className,
  useDefaultEditableBinding = false,
  "data-prop": customDataProp,
  // Destructured so it can't reach the outer wrapper via htmlAttributes — the key
  // belongs on the inner span, or Rosey captures the surrounding <p> too.
  "data-rosey": roseyId,
  _component,
  ...htmlAttributes
} = Astro.props;

const md = MarkdownIt({ html: true });
let MarkdownText = text ? md.renderInline(text) : "";

MarkdownText = MarkdownText.replace(/\n/g, "<br />");

const effectiveDataProp = customDataProp ?? (useDefaultEditableBinding ? "text" : null);
// renderInline() output is inline-rich, so data-type is "text". Without it the
// region defaults to plain "span" and markdown fields read as perpetually stale.
const textDataAttributes = effectiveDataProp
  ? { "data-editable": "text", "data-type": "text", "data-prop": effectiveDataProp }
  : {};
const roseyAttributes = resolveRosey(roseyId, effectiveDataProp);

const hasText = text?.trim().length > 0;
const hasSlotContent = Astro.slots.has("default");

if (!_component && !hasText && !hasSlotContent) return;
---

<div
  class:list={["simple-text", className]}
  {...htmlAttributes}
>
  <p class:list={["simple-text-content", size && `size-${size}`, `align-${alignmentHorizontal}`]}>
    <span
      class="simple-text-inner"
      {...textDataAttributes}
      {...roseyAttributes}
    >
      <slot>
        {text && <Fragment set:html={MarkdownText} />}
      </slot>
    </span>
  </p>
</div>

<style is:global>
  @layer components {
    .simple-text {
      margin-top: var(--spacing-lg);

      > .simple-text-content {
        margin: 0;

        &.size-xs {
          font-size: var(--font-size-xs);
        }

        &.size-sm {
          font-size: var(--font-size-sm);
        }

        &.size-md {
          font-size: var(--font-size-md);
        }

        &.size-lg {
          font-size: var(--font-size-lg);
        }

        &.size-xl {
          font-size: var(--font-size-xl);
        }

        &.size-2xl {
          font-size: var(--font-size-2xl);
        }

        &.size-3xl {
          font-size: var(--font-size-3xl);
        }

        &.size-4xl {
          font-size: var(--font-size-4xl);
        }

        &.align-start {
          text-align: start;
        }

        &.align-center {
          text-align: center;
        }

        &.align-end {
          text-align: end;
        }
      }
    }
  }
</style>
