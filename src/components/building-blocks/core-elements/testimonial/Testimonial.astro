---
import Image from "@core-elements/image/Image.astro";
import { isEditable } from "@component-utils/editable";
import { resolveRosey } from "@component-utils/roseyKey";
import MarkdownIt from "markdown-it";
const {
  text,
  authorName,
  authorDescription,
  alignmentHorizontal = "center",
  authorImage = "",
  class: className,
  useDefaultEditableBinding,
  "data-prop": customDataProp,
  "data-prop-author-name": customDataPropAuthorName,
  "data-prop-author-description": customDataPropAuthorDescription,
  "data-rosey": roseyId,
  "data-rosey-author-name": roseyAuthorName,
  "data-rosey-author-description": roseyAuthorDescription,
  _uuid,
  _component,
  ...htmlAttributes
} = Astro.props;

const md = MarkdownIt({ html: true });
const MarkdownText = text ? md.render(text) : "";

const isContentBlock = isEditable(Astro.props);

const effectiveDataProp = customDataProp ?? (isContentBlock ? "text" : null);
// md.render() output is block-level; see Text.astro for why data-type matters.
const textDataAttributes = effectiveDataProp
  ? { "data-editable": "text", "data-type": "block", "data-prop": effectiveDataProp }
  : {};
const roseyAttributes = resolveRosey(roseyId, effectiveDataProp);

const effectiveAuthorNameProp = customDataPropAuthorName ?? (isContentBlock ? "authorName" : null);
const authorNameDataAttributes = effectiveAuthorNameProp
  ? { "data-editable": "text", "data-prop": effectiveAuthorNameProp }
  : {};
// Author names are identity values — call sites pass data-rosey-author-name={false}.
const authorNameRoseyAttributes = resolveRosey(roseyAuthorName, effectiveAuthorNameProp);

const effectiveAuthorDescProp =
  customDataPropAuthorDescription ?? (isContentBlock ? "authorDescription" : null);
const authorDescriptionDataAttributes = effectiveAuthorDescProp
  ? { "data-editable": "text", "data-prop": effectiveAuthorDescProp }
  : {};
const authorDescriptionRoseyAttributes = resolveRosey(
  roseyAuthorDescription,
  effectiveAuthorDescProp
);
---

{
  /* The namespace needs a holder of its own: the root is the region element, which a
  re-render copies into, and .quote is the tagged element. */
}
<blockquote
  class:list={["testimonial", `alignment-${alignmentHorizontal}`, className]}
  {...htmlAttributes}
>
  <div
    class="quote-ns"
    data-rosey-ns={_uuid}
  >
    <div
      class="quote"
      {...textDataAttributes}
      {...roseyAttributes}
    >
      <slot>
        {text && <Fragment set:html={MarkdownText} />}
      </slot>
    </div>
  </div>
  <div
    class="author"
    data-rosey-ns={_uuid}
  >
    <Image
      source={authorImage}
      alt={authorName}
      width={100}
      height={100}
      class="author-image"
      data-prop-src="authorImage"
      data-prop-alt="authorName"
    />
    <cite class="author-content">
      <strong
        class="name"
        {...authorNameDataAttributes}
        {...authorNameRoseyAttributes}
      >
        {authorName}
      </strong>
      {
        authorDescription && (
          <>
            <br />
            <span
              class="description"
              {...authorDescriptionDataAttributes}
              {...authorDescriptionRoseyAttributes}
            >
              {authorDescription}
            </span>
          </>
        )
      }
    </cite>
  </div>
</blockquote>

<style is:global>
  @layer components {
    .testimonial {
      border: none;
      display: flex;
      flex-direction: row-reverse;
      flex-wrap: wrap;
      gap: var(--spacing-sm);
      justify-content: center;
      margin: 0;
      padding: var(--spacing-md);

      @media (width >= 768px) {
        gap: var(--spacing-2xl);
      }

      &.alignment-center {
        align-items: center;
        justify-content: center;
        text-align: center;
      }

      /* Namespace holder — must not add a box. */
      > .quote-ns {
        display: contents;
      }

      .quote {
        align-content: center;
        flex: 1 1 var(--content-width-sm);
        font-size: var(--font-size-3xl);
        font-weight: var(--font-weight-bold);
        margin: 0;

        > p {
          font-size: var(--font-size-3xl);
          font-weight: var(--font-weight-bold);
        }

        @media (width < 1024px) {
          text-align: center;
        }

        *:first-child {
          margin-top: 0;
        }

        *:last-child {
          margin-bottom: 0;
        }

        *:first-child::before {
          content: "\201C";
        }

        *:last-child::after {
          content: "\201D";
        }
      }

      > .author {
        align-items: center;
        display: flex;
        flex-direction: column;
        flex-shrink: 0;
        gap: var(--spacing-md);
        width: 25%;

        > .author-content {
          font-style: normal;
          text-align: center;
        }

        > .image.author-image {
          aspect-ratio: var(--ratio-square);
          height: 80px;
          margin-top: 0;
          overflow: hidden;
          width: 80px;

          > .image-inner {
            height: 100%;
            width: 100%;
          }

          picture {
            border-radius: var(--radius-full);
            height: 100%;
            overflow: hidden;
            width: 80px;
          }

          img {
            height: 100%;
            object-fit: cover;
            width: 80px;
          }
        }
      }
    }
  }
</style>
