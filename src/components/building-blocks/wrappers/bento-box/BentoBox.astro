---
import BentoBoxItem from "./BentoBoxItem.astro";

const {
  class: className,
  style: userStyle,
  items = [],
  label,
  gap = "md",
  useDefaultEditableBinding = false,
  _component,
  "data-children-prop": childrenDataProp,
  ...htmlAttributes
} = Astro.props;

const slugifyLabel = (label: string) => {
  return label
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
};

if (!htmlAttributes.id && label) {
  htmlAttributes.id = slugifyLabel(label);
}

const gridStyles = [`--grid-spacing: var(--spacing-${gap})`, userStyle].filter(Boolean).join("; ");

const effectiveChildrenProp = childrenDataProp ?? (useDefaultEditableBinding ? "items" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? {
      "data-editable": "array",
      "data-prop": effectiveChildrenProp,
      "data-direction": "row",
    }
  : {};

const hasItems = items?.length > 0;
const hasSlotContent = Astro.slots.has("default");

if (!_component && !hasItems && !hasSlotContent) return;
---

<div
  class:list={["bento-box", className]}
  {...htmlAttributes}
>
  <div
    {...arrayDataAttributes}
    class="bento-box-inner"
    style={gridStyles}
  >
    <slot>
      {
        items?.map((item: any) => (
          <BentoBoxItem
            data-id="building-blocks/wrappers/bento-box/bento-box-item"
            data-editable="array-item"
            useDefaultEditableBinding={!!effectiveChildrenProp}
            {...item}
          />
        ))
      }
    </slot>
  </div>
</div>

<style>
  @layer components {
    .bento-box {
      margin-top: var(--spacing-lg);
      width: 100%;
    }

    .bento-box > .bento-box-inner {
      display: grid;
      gap: var(--grid-spacing, var(--spacing-md));
      grid-template-columns: repeat(12, 1fr);
      width: 100%;
    }
  }
</style>
