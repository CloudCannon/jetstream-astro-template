---
import { isEditable } from "@component-utils/editable";
import RenderBlock from "@components/utils/renderBlock.astro";

/*
  The content of one grid cell. The surrounding `.bento-box-grid-item` cell is rendered by
  BentoBoxGridCell — see the reasoning there. This component's root must stay the cell's only
  child, because it is what CloudCannon's re-render diffs against, and the spans have to sit
  on it rather than on the cell for the span inputs to update live.
*/
const {
  contentSections,
  useDefaultEditableBinding,
  class: className,
  style: userStyle,
  columnSpan = 4,
  rowSpan = 1,
  // Structural wrapper: no namespace of its own. Its children carry their own _uuid,
  // so a block keeps its translation when moved between wrappers. Destructured only
  // to keep it off the DOM.
  _uuid,
  _component,
  "data-children-prop": childrenDataProp,
  ...htmlAttributes
} = Astro.props;

const isContentBlock = isEditable(Astro.props);
const effectiveChildrenProp = childrenDataProp ?? (isContentBlock ? "contentSections" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? {
      "data-editable": "array",
      "data-prop": effectiveChildrenProp,
      "data-component-key": "_component",
      "data-id-key": "_uuid",
    }
  : {};
---

<div
  class:list={["bento-box-grid-item-content", className]}
  data-column-span={columnSpan}
  data-row-span={rowSpan}
  style={userStyle}
  {...arrayDataAttributes}
  {...htmlAttributes}
>
  <slot>
    {
      contentSections && (
        <RenderBlock
          contentSections={contentSections}
          useDefaultEditableBinding={!!effectiveChildrenProp}
        />
      )
    }
  </slot>
</div>
