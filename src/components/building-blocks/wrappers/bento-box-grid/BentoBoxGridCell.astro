---
/*
  A cell in a bento box grid. The grid emits one of these per item; the component that fills
  it renders its own `.bento-box-grid-item-content` root inside.

  The cell exists as its own element because CloudCannon re-renders a component region by
  diffing the fresh render's children into the region element's children. A region element
  that is also the component's root therefore merges the render a level too deep: the root's
  attributes land on the region's first child, and any attribute that child had which the root
  lacks is deleted. That stripped `data-column-span` off the content and collapsed the grid
  into a single column in the visual editor.

  This file also owns the cell CSS, including the rules that reach into the content root.
  Those rules only matter when a cell is present, and a cell being present is exactly what
  puts them in the bundle — so an item component never has to import styles it doesn't render.
*/
const {
  // Set these to make the cell an editable array item. Left unset for static grids.
  component,
  uuid,
  class: className,
  ...htmlAttributes
} = Astro.props;

const regionAttributes = component
  ? {
      "data-editable": "array-item",
      "data-component": component,
      "data-id": uuid ?? component,
    }
  : {};
---

<div
  class:list={["bento-box-grid-item", className]}
  {...regionAttributes}
  {...htmlAttributes}
>
  <slot />
</div>

<style is:global>
  @layer components {
    /*
      This element carries `data-editable="array-item"`, so it must generate a box for
      CloudCannon's reorder/drag controls to anchor and hit-test against — `display: contents`
      leaves them positioned against a distant ancestor and unusable.

      The spans are read from data attributes on the child rather than a custom property set
      here, because CloudCannon never diffs an array item's own attributes on re-render — only
      its descendants'. Keeping the values on the child is what lets the span inputs update
      live in the visual editor.
    */
    .bento-box-grid-item {
      grid-column: 1 / -1;
      padding: var(--spacing-sm);
      height: 100%;
    }

    .bento-box-grid-item:has(> [data-row-span="2"]) {
      grid-row: span 2;
    }
    .bento-box-grid-item:has(> [data-row-span="3"]) {
      grid-row: span 3;
    }
    .bento-box-grid-item:has(> [data-row-span="4"]) {
      grid-row: span 4;
    }

    @media (width >= 768px) {
      .bento-box-grid-item:has(> [data-column-span="1"]) {
        grid-column: span 1;
      }
      .bento-box-grid-item:has(> [data-column-span="2"]) {
        grid-column: span 2;
      }
      .bento-box-grid-item:has(> [data-column-span="3"]) {
        grid-column: span 3;
      }
      .bento-box-grid-item:has(> [data-column-span="4"]) {
        grid-column: span 4;
      }
      .bento-box-grid-item:has(> [data-column-span="5"]) {
        grid-column: span 5;
      }
      .bento-box-grid-item:has(> [data-column-span="6"]) {
        grid-column: span 6;
      }
      .bento-box-grid-item:has(> [data-column-span="7"]) {
        grid-column: span 7;
      }
      .bento-box-grid-item:has(> [data-column-span="8"]) {
        grid-column: span 8;
      }
      .bento-box-grid-item:has(> [data-column-span="9"]) {
        grid-column: span 9;
      }
      .bento-box-grid-item:has(> [data-column-span="10"]) {
        grid-column: span 10;
      }
      .bento-box-grid-item:has(> [data-column-span="11"]) {
        grid-column: span 11;
      }
      .bento-box-grid-item:has(> [data-column-span="12"]) {
        grid-column: span 12;
      }
    }

    .bento-box-grid-item > .bento-box-grid-item-content {
      container-type: inline-size;
      height: 100%;
    }

    .bento-box-grid-item > .bento-box-grid-item-content > *:only-child {
      height: 100%;
    }

    .bento-box-grid-item > .bento-box-grid-item-content > *:first-child {
      margin-top: 0 !important;
    }
  }
</style>
