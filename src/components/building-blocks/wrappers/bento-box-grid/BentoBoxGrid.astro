---
import { isEditable } from "@component-utils/editable";
import RenderBlock from "@components/utils/renderBlock.astro";
import BentoBoxGridCell from "./BentoBoxGridCell.astro";

const {
  layout = "center",
  class: className,
  style: userStyle,
  items = [],
  label,
  gap = "md",
  useDefaultEditableBinding,
  _uuid,
  _component,
  "data-children-prop": childrenDataProp,
  ...htmlAttributes
} = Astro.props;

const slugifyLabel = (label: string) => {
  return label
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-+|-+$/g, "");
};

if (!htmlAttributes.id && label) {
  htmlAttributes.id = slugifyLabel(label);
}

const gridStyles = [`--grid-spacing: var(--spacing-${gap})`, userStyle].filter(Boolean).join("; ");

const isContentBlock = isEditable(Astro.props);
const effectiveChildrenProp = childrenDataProp ?? (isContentBlock ? "items" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? {
      "data-editable": "array",
      "data-prop": effectiveChildrenProp,
      "data-direction": "row",
      "data-component-key": "_component",
      "data-id-key": "_uuid",
    }
  : {};

const hasItems = items?.length > 0;
const slotContent = Astro.slots.has("default") ? await Astro.slots.render("default") : null;
const hasSlotContent = (slotContent?.toString().trim().length ?? 0) > 0;

if (!_component && !hasItems && !hasSlotContent) return;
---

<div
  class:list={["bento-box-grid", className]}
  {...htmlAttributes}
>
  <div
    {...arrayDataAttributes}
    class:list={["bento-box-grid-inner", `layout-${layout}`]}
    style={gridStyles}
  >
    <slot>
      {
        /* The grid owns the cells, so any block can be an item — not just BentoBoxGridItem.
          The cell is what hosts the array-item region; the block renders its own content root
          inside it. */
      }
      {
        items?.map((item: any) => (
          <BentoBoxGridCell
            component={effectiveChildrenProp ? item._component : undefined}
            uuid={item._uuid}
            class:list={`layout-${layout}`}
          >
            <RenderBlock
              contentSections={[item]}
              useDefaultEditableBinding={!!effectiveChildrenProp}
              markArrayItems={false}
            />
          </BentoBoxGridCell>
        ))
      }
    </slot>
  </div>
</div>

<style>
  @layer components {
    .bento-box-grid {
      margin-top: var(--spacing-lg);
      width: 100%;
    }

    .bento-box-grid > .bento-box-grid-inner {
      display: grid;
      gap: var(--grid-spacing, var(--spacing-md));
      grid-template-columns: repeat(12, 1fr);
      width: 100%;
    }
  }
</style>
