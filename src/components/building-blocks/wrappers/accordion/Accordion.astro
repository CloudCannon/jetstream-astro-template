---
import { isEditable } from "@component-utils/editable";
import { slugifyLabel } from "@components/utils/slugify";
import AccordionItem from "./AccordionItem.astro";

type ItemProps = Record<string, unknown>;

const {
  items,
  openFirst,
  singleOpen = false,
  label,
  useDefaultEditableBinding,
  "data-children-prop": childrenDataProp,
  _uuid,
  _component,
  ...htmlAttributes
} = Astro.props;

const generatedLabel = label || `Accordion-${crypto.randomUUID()}`;

if (!htmlAttributes.id) {
  htmlAttributes.id = slugifyLabel(generatedLabel);
}

const accordionName = singleOpen ? `accordion-${crypto.randomUUID()}` : undefined;

const isContentBlock = isEditable(Astro.props);
const effectiveChildrenProp = childrenDataProp ?? (isContentBlock ? "items" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? {
      "data-editable": "array",
      "data-prop": effectiveChildrenProp,
      "data-component-key": "_component",
      "data-id-key": "_uuid",
    }
  : {};

const itemComponent = "building-blocks/wrappers/accordion/accordion-item";

const hasItems = items?.length > 0;
const hasSlotContent = Astro.slots.has("default");

if (!_component && !hasItems && !hasSlotContent) return;
---

<div
  class:list={["accordion"]}
  {...htmlAttributes}
>
  <div {...arrayDataAttributes}>
    <slot>
      {
        items?.map((item: ItemProps, index: number) => {
          const isFirst = index === 0 && openFirst;

          return (
            /* The region host must wrap the item, never be its root: a re-render diffs the
            rendered component's children into the host's children, so region attrs on
            `<details>` itself nest the whole item one level deeper each restore. */
            <div
              data-editable="array-item"
              data-component={itemComponent}
              data-id={item._uuid ?? itemComponent}
            >
              <AccordionItem
                isOpen={isFirst}
                accordionName={accordionName}
                useDefaultEditableBinding={!!effectiveChildrenProp}
                {...item}
              />
            </div>
          );
        })
      }
    </slot>
  </div>
</div>

<style is:global>
  @layer components {
    .accordion {
      margin-top: var(--spacing-lg);
    }
  }
</style>
