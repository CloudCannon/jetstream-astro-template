---
import { isEditable } from "@component-utils/editable";
import RenderBlock from "@components/utils/renderBlock.astro";

const {
  action,
  formBlocks = [],
  class: className,
  _uuid,
  _component,
  useDefaultEditableBinding,
  "data-children-prop": childrenDataProp,
  ...htmlAttributes
} = Astro.props;

const isContentBlock = isEditable(Astro.props);
const effectiveChildrenProp = childrenDataProp ?? (isContentBlock ? "formBlocks" : null);
const arrayDataAttributes = effectiveChildrenProp
  ? {
      "data-editable": "array",
      "data-prop": effectiveChildrenProp,
      "data-component-key": "_component",
      "data-id-key": "_uuid",
    }
  : {};

const hasFormBlocks = formBlocks?.length > 0;
const hasSlotContent = Astro.slots.has("default");
const usesFormBlocks = !hasSlotContent;

if (!_component && !hasFormBlocks && !usesFormBlocks) return;
---

<form
  class:list={["form", className]}
  action={action}
  method="post"
  enctype="multipart/form-data"
  {...htmlAttributes}
>
  <div {...arrayDataAttributes}>
    <slot>
      {
        formBlocks && (
          <RenderBlock
            contentSections={formBlocks}
            useDefaultEditableBinding={!!effectiveChildrenProp}
          />
        )
      }
    </slot>
  </div>
</form>

<style is:global>
  @layer components {
    .form {
      margin-top: var(--spacing-lg);
      width: 100%;
    }
  }
</style>
