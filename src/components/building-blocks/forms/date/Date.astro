---
const {
  label,
  name,
  required = false,
  value,
  min,
  max,
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  id,
  _uuid,
  _component,
  ...htmlAttributes
} = Astro.props;

const fieldId = id || `date-${crypto.randomUUID()}`;
---

{
  /* htmlAttributes carries the caller's data-editable/data-component. CloudCannon's
    re-render replaces this element's children with a fresh copy of the component, so
    data-rosey-ns has to sit strictly inside it — on the root it would be re-emitted by
    the copy, doubling the namespace on every key below. */
}
<div
  class:list={["date", className]}
  {...htmlAttributes}
>
  {
    label && (
      <label
        for={fieldId}
        class="label"
        data-rosey-ns={_uuid}
      >
        {/* Key on the span, not the <label> — the required marker is a non-text child. */}
        <span data-rosey="label">{label}</span>
        {required && (
          <span
            class="date-required"
            aria-label="required"
          >
            *
          </span>
        )}
      </label>
    )
  }
  <input
    type="date"
    name={name}
    id={fieldId}
    required={required}
    aria-required={required}
    value={value}
    min={min}
    max={max}
    class="field"
  />
</div>

<style is:global>
  @layer components {
    .date {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xs);
      width: 100%;
      margin: 0;
      margin-bottom: var(--spacing-md);

      .date-required {
        color: red;
        margin-inline-end: var(--spacing-em-xs);
      }
    }
  }
</style>
