---
import Icon from "@core-elements/icon/Icon.astro";

const {
  label,
  name,
  type = "text",
  placeholder,
  required = false,
  value,
  iconName,
  iconColor = "default",
  iconPosition = "before",
  id: customId,
  class: className,
  useDefaultEditableBinding: _useDefaultEditableBinding = false,
  _uuid,
  _component,
  ...htmlAttributes
} = Astro.props;

const fieldId = customId || `input-${crypto.randomUUID()}`;
const hasIcon = iconName?.trim().length > 0;
---

{
  /* htmlAttributes carries the caller's data-editable/data-component. CloudCannon's
    re-render replaces this element's children with a fresh copy of the component, so
    data-rosey-ns has to sit strictly inside it — on the root it would be re-emitted by
    the copy, doubling the namespace on every key below. */
}
<div
  class:list={["input", className]}
  {...htmlAttributes}
>
  {
    label && (
      <label
        for={fieldId}
        class="label"
        data-rosey-ns={_uuid}
      >
        {/* The key goes on this span, not the <label>: the required marker below is a
            non-text child and would otherwise be captured and injected twice. */}
        <span data-rosey="label">{label}</span>
        {required && (
          <span
            class="input-required"
            aria-label="required"
          >
            *
          </span>
        )}
      </label>
    )
  }
  {
    hasIcon ? (
      <span class:list={["field-shell", iconPosition === "after" && "icon-after"]}>
        <Icon
          name={iconName}
          color={iconColor}
          size="none"
          class="input-icon"
          aria-hidden="true"
          role="presentation"
        />
        <input
          type={type}
          name={name}
          id={fieldId}
          placeholder={placeholder}
          required={required}
          aria-required={required}
          value={value}
          class="field"
          data-rosey-ns={_uuid}
          data-rosey-attrs-explicit={
            placeholder ? JSON.stringify({ placeholder: "placeholder" }) : undefined
          }
        />
      </span>
    ) : (
      <input
        type={type}
        name={name}
        id={fieldId}
        placeholder={placeholder}
        required={required}
        aria-required={required}
        value={value}
        class="field"
        data-rosey-ns={_uuid}
        data-rosey-attrs-explicit={
          placeholder ? JSON.stringify({ placeholder: "placeholder" }) : undefined
        }
      />
    )
  }
</div>

<style is:global>
  @layer components {
    .input {
      display: flex;
      flex-direction: column;
      gap: var(--spacing-xs);
      width: 100%;
      margin: 0;
      margin-bottom: var(--spacing-md);

      .input-required {
        color: red;
        margin-inline-end: var(--spacing-em-xs);
      }

      .field-shell {
        align-items: center;
        background-color: var(--color-bg);
        border: 1px solid var(--color-border-inputs);
        border-radius: var(--radius-xs);
        display: flex;
        gap: var(--spacing-em-sm);
        padding-inline: var(--spacing-em-sm);
        transition:
          border-color var(--animation-normal) ease-in-out,
          box-shadow var(--animation-normal) ease-in-out;

        &:focus-within {
          border-color: var(--color-brand);
          box-shadow: 0 0 0 3px var(--color-focus-ring);
        }

        &.icon-after {
          flex-direction: row-reverse;
        }

        .input-icon {
          color: var(--color-text-muted);
          flex-shrink: 0;
          font-size: 1.25em;
        }

        > .field {
          background-color: transparent;
          border: 0;
          border-radius: 0;
          box-shadow: none;
          flex: 1 1 auto;
          min-width: 0;
          padding-inline: 0;

          &:focus {
            box-shadow: none;
          }
        }
      }
    }
  }
</style>
