---
import { Icon as AstroIcon } from "astro-icon/components";
import {
  defaultLanguageAtRoot,
  defaultLocale,
  localeCodes,
  locales,
} from "@component-utils/locales";

const { class: className, _component, ...htmlAttributes } = Astro.props;

const options = [
  { code: defaultLocale, label: defaultLocale.toUpperCase() },
  ...localeCodes.map((code) => ({ code, label: locales[code].label })),
];
const allCodes = options.map((option) => option.code);

// Strip any locale prefix to get the path all languages share, then re-prefix per
// language. These links carry data-rosey-ignore, so Rosey never rewrites them and the
// prefix has to be emitted here.
const segments = Astro.url.pathname.split("/").filter(Boolean);
const rest = allCodes.includes(segments[0] as (typeof allCodes)[number])
  ? segments.slice(1)
  : segments;
const basePath = `/${rest.join("/")}${rest.length ? "/" : ""}`;

function buildPath(code: string) {
  if (code === defaultLocale && defaultLanguageAtRoot) return basePath;
  return `/${code}${basePath}`;
}

const panelId = `locale-picker-${crypto.randomUUID()}`;

// Rosey clones this markup into every locale, so the build-time HTML always reflects the
// default language — but Rosey does rewrite `<html lang>`. Mapping that to an index in
// CSS means the right language is highlighted in the first paint, with no client-side
// correction, and it keeps following along if the router swaps `lang` mid-session.
// Generated rather than hand-written so adding a locale to locales.ts is enough.
const localeIndexCss = options
  .map(
    ({ code }, index) => `:root:lang(${code}){--locale-index:${index};}
.locale-picker-options:has(> a:nth-of-type(${index + 1}):is(:hover, :focus-visible)){--locale-hover-index:${index};}`
  )
  .join("\n");
---

<style is:inline set:html={localeIndexCss}></style>

<div
  class:list={["locale-picker", className]}
  {...htmlAttributes}
>
  {
    /* Collapsed form, shown only where the full control doesn't fit. One toggle per page
      and no _uuid to namespace with, so the label lives under the shared "ui" root. */
  }
  <button
    type="button"
    class="locale-picker-trigger"
    aria-controls={panelId}
    aria-expanded="false"
    aria-label="Change language"
    data-rosey-root="ui"
    data-rosey-attrs-explicit={JSON.stringify({ "aria-label": "locale_picker" })}
  >
    <span class="locale-picker-globe">
      <AstroIcon
        name="globe-alt"
        is:inline
      />
    </span>
    <span
      class="locale-picker-code"
      aria-hidden="true"
    >
      <span class="locale-picker-code-stack">
        {options.map(({ label }) => <span>{label}</span>)}
      </span>
    </span>
    <span class="locale-picker-chevron">
      <AstroIcon
        name="chevron-down"
        is:inline
      />
    </span>
  </button>

  <nav
    id={panelId}
    aria-label="Language"
    class="locale-picker-options"
    style={`--count: ${options.length}`}
  >
    {
      /* The indicator carries its own clipped copy of the labels, so the highlighted text
        wipes in and out as the pill slides rather than cross-fading in place. */
    }
    <span
      class="locale-picker-thumb"
      aria-hidden="true"
    >
      <span class="locale-picker-thumb-labels">
        {options.map(({ label }) => <span>{label}</span>)}
      </span>
    </span>
    {
      options.map(({ code, label }, index) => (
        <a
          href={buildPath(code)}
          data-rosey-ignore
          hreflang={code}
          style={`--index: ${index}`}
        >
          {label}
        </a>
      ))
    }
  </nav>
</div>

<style>
  @layer components {
    .locale-picker {
      /* Between --animation-normal and --animation-slow: the indicator overshoots
         slightly on arrival, which needs a little more room to read. */
      --locale-picker-slide: 320ms;
      --locale-picker-ease: cubic-bezier(0.34, 1.35, 0.5, 1);

      display: inline-flex;
      position: relative;
    }

    /* Segmented track when there's room, dropdown panel when there isn't. */
    .locale-picker-options {
      /* Indicator sits under whatever is hovered or focused, and settles back on the
         current language when nothing is. */
      --active-index: var(--locale-hover-index, var(--locale-index, 0));

      background: color-mix(in srgb, var(--color-brand) 8%, var(--color-bg));
      border: 1px solid color-mix(in srgb, var(--color-brand) 18%, transparent);
      border-radius: var(--radius-sm);
      display: grid;
      grid-auto-columns: 1fr;
      grid-auto-flow: column;
      overflow: hidden;
      position: relative;

      a {
        align-items: center;
        color: var(--color-text);
        display: flex;
        font-family: var(--font-mono);
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-bold);
        justify-content: center;
        letter-spacing: 0.04em;
        min-height: 2rem;
        padding: var(--spacing-xs) var(--spacing-sm);
        text-decoration: none;
        transition: color var(--animation-normal) ease-in-out;

        &:hover {
          color: var(--color-text-strong);
        }

        /* Inset, because the track clips the thumb and would clip an outline too. */
        &:focus-visible {
          box-shadow: 0 0 2px 2px var(--color-focus-ring) inset;
          outline: none;
        }
      }
    }

    .locale-picker-thumb {
      background: var(--color-bg-brand);
      border-radius: calc(var(--radius-sm) - 2px);
      bottom: 0;
      box-shadow: 0 2px 10px color-mix(in srgb, var(--color-brand) 35%, transparent);
      color: var(--color-text-on-brand);
      left: 0;
      overflow: hidden;
      pointer-events: none;
      position: absolute;
      top: 0;
      transform: translateX(calc(var(--active-index) * 100%));
      transition: transform var(--locale-picker-slide) var(--locale-picker-ease);
      width: calc(100% / var(--count));
      will-change: transform;
    }

    /* Same grid as the track, shifted the opposite way, so each label lands exactly
       over the real one underneath. */
    .locale-picker-thumb-labels {
      display: grid;
      grid-auto-columns: 1fr;
      grid-auto-flow: column;
      height: 100%;
      transform: translateX(calc(var(--active-index) * -100% / var(--count)));
      transition: transform var(--locale-picker-slide) var(--locale-picker-ease);
      width: calc(100% * var(--count));

      > span {
        align-items: center;
        display: flex;
        font-family: var(--font-mono);
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-bold);
        justify-content: center;
        letter-spacing: 0.04em;
      }
    }

    .locale-picker-trigger {
      align-items: center;
      background: color-mix(in srgb, var(--color-brand) 8%, var(--color-bg));
      border: 1px solid color-mix(in srgb, var(--color-brand) 18%, transparent);
      border-radius: var(--radius-sm);
      color: var(--color-text-strong);
      cursor: pointer;
      display: none;
      font-family: var(--font-mono);
      font-size: var(--font-size-sm);
      font-weight: var(--font-weight-bold);
      gap: var(--spacing-xs);
      letter-spacing: 0.04em;
      line-height: 1.25;
      min-height: 2.25rem;
      padding: var(--spacing-xs) var(--spacing-sm);
      transition:
        background-color var(--animation-normal) ease-in-out,
        border-color var(--animation-normal) ease-in-out;

      &:hover {
        background: color-mix(in srgb, var(--color-brand) 16%, var(--color-bg));
        border-color: color-mix(in srgb, var(--color-brand) 40%, transparent);
      }

      &:focus-visible {
        outline: 2px solid var(--color-focus-ring);
        outline-offset: 2px;
      }
    }

    .locale-picker-globe {
      display: block;
      font-size: 1.15em;
      line-height: 0;
      transition: transform var(--animation-slow) var(--locale-picker-ease);

      svg {
        height: 1em;
        width: 1em;
      }
    }

    .locale-picker-trigger:hover .locale-picker-globe,
    .locale-picker[data-open] .locale-picker-globe {
      transform: rotate(1turn);
    }

    /* Every code is in the markup; the current one is slid into a one-line window. Same
       reason as --locale-index: Rosey can't rewrite this text, but it does set `lang`. */
    .locale-picker-code {
      display: block;
      height: 1.25em;
      overflow: hidden;
    }

    .locale-picker-code-stack {
      display: block;
      transform: translateY(calc(var(--locale-index, 0) * -1.25em));
      transition: transform var(--locale-picker-slide) var(--locale-picker-ease);

      > span {
        display: block;
        height: 1.25em;
      }
    }

    .locale-picker-chevron {
      color: var(--color-text-muted);
      display: block;
      font-size: 0.9em;
      line-height: 0;
      transition: transform var(--animation-normal) ease-in-out;

      svg {
        height: 1em;
        width: 1em;
      }
    }

    .locale-picker[data-open] .locale-picker-chevron {
      transform: rotate(180deg);
    }

    /* Roomy containers — the mobile menu — get the full-width control. */
    .locale-picker--block {
      display: block;
    }

    .locale-picker--block .locale-picker-options a {
      min-height: 2.75rem;
    }

    /*
     * Collapsed form: a globe + current code that opens the options as a dropdown. Gated
     * on --responsive so it only applies to the picker sharing the nav bar with the
     * logo, buttons and hamburger; the container is the nav's own content box.
     */
    @container (max-width: 768px) {
      .locale-picker--responsive {
        .locale-picker-trigger {
          display: inline-flex;
        }

        .locale-picker-options {
          background: var(--color-bg);
          border-color: var(--color-border-subtle);
          box-shadow: 0 12px 30px var(--color-shadow);
          grid-auto-flow: row;
          grid-auto-rows: 1fr;
          min-width: 100%;
          opacity: 0;
          position: absolute;
          right: 0;
          top: calc(100% + var(--spacing-xs));
          transform: translateY(-0.375rem) scale(0.96);
          transform-origin: top right;
          transition:
            opacity var(--animation-normal) ease-out,
            transform var(--animation-normal) ease-out,
            visibility 0s linear var(--animation-normal);
          visibility: hidden;
          z-index: var(--layer-3);

          a {
            min-height: 2.5rem;
            opacity: 0;
            padding-inline: var(--spacing-md);
            transform: translateY(-0.25rem);
            transition:
              color var(--animation-normal) ease-in-out,
              opacity var(--animation-normal) ease-out,
              transform var(--animation-normal) ease-out;
          }
        }

        .locale-picker-thumb {
          bottom: auto;
          height: calc(100% / var(--count));
          right: 0;
          transform: translateY(calc(var(--active-index) * 100%));
          width: auto;
        }

        .locale-picker-thumb-labels {
          grid-auto-flow: row;
          grid-auto-rows: 1fr;
          height: calc(100% * var(--count));
          transform: translateY(calc(var(--active-index) * -100% / var(--count)));
          width: 100%;
        }

        &[data-open] .locale-picker-options {
          opacity: 1;
          transform: none;
          transition-delay: 0s;
          visibility: visible;

          /* Options arrive one after the other rather than all at once. */
          a {
            opacity: 1;
            transform: none;
            transition-delay: calc(var(--index) * 45ms);
          }
        }
      }
    }
  }
</style>

<script>
  import { onPageLoad } from "@component-utils/onPageLoad";

  function setOpen(picker: HTMLElement, open: boolean) {
    picker.toggleAttribute("data-open", open);
    picker.querySelector(".locale-picker-trigger")?.setAttribute("aria-expanded", String(open));
  }

  function closeAllExcept(current: Element | null) {
    document.querySelectorAll<HTMLElement>(".locale-picker[data-open]").forEach((picker) => {
      if (picker !== current) setOpen(picker, false);
    });
  }

  // Delegated so the collapsed dropdown keeps working after a router swap replaces the nav.
  document.addEventListener("click", (event) => {
    const target = event.target as Element | null;
    const trigger = target?.closest(".locale-picker-trigger");
    const picker = trigger?.closest<HTMLElement>(".locale-picker") ?? null;

    closeAllExcept(picker);
    if (picker) setOpen(picker, !picker.hasAttribute("data-open"));
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape") return;

    const open = document.querySelector<HTMLElement>(".locale-picker[data-open]");
    if (!open) return;

    setOpen(open, false);
    open.querySelector<HTMLButtonElement>(".locale-picker-trigger")?.focus();
  });

  // Tabbing out of the dropdown should close it, same as clicking away.
  document.addEventListener("focusin", (event) => {
    closeAllExcept((event.target as Element | null)?.closest(".locale-picker") ?? null);
  });

  function initLocalePickers() {
    if (window.inEditorMode) {
      // The connector injects its own floating locale switcher in the Visual Editor.
      // Hiding this one avoids two competing switchers.
      document
        .querySelectorAll<HTMLElement>(".locale-picker")
        .forEach((picker) => (picker.style.display = "none"));
      return;
    }

    // CSS handles the highlight off `<html lang>`; aria-current can't be set from there.
    const lang = document.documentElement.lang.slice(0, 2).toLowerCase();

    document.querySelectorAll<HTMLAnchorElement>(".locale-picker-options a").forEach((link) => {
      if (link.hreflang === lang) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    });
  }

  onPageLoad(initLocalePickers);
</script>
