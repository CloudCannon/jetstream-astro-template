---
import { resolveImageSource } from "@component-utils/resolveImageSource";

interface SiteSeoData {
  name: string;
  url: string;
  logoSource: string;
  description: string;
  titleFormat: string;
}

interface ArticleSeoData {
  publishedTime?: string | null;
  modifiedTime?: string | null;
  author?: string | string[] | null;
  tags?: string[] | null;
}

export interface Props {
  site: SiteSeoData;
  title?: string | null;
  description?: string | null;
  keywords?: string[] | null;
  image?: string | null;
  canonical?: string | null;
  type?: "website" | "article";
  article?: ArticleSeoData | null;
  noindex?: boolean;
  // Head text isn't on the page, so it's only reachable through the Locales collection.
  // Opt-in per route: pages whose head comes from translated content must not have keys,
  // since a Rosey value would override the content file's own title.
  roseyTitleKey?: string;
  roseyDescriptionKey?: string;
}

const {
  site,
  title,
  description,
  keywords,
  image,
  canonical,
  type: pageType = "website",
  article,
  noindex = false,
  roseyTitleKey,
  roseyDescriptionKey,
} = Astro.props;
const plainTitle = title?.replace(/<[^>]*>/g, "").trim();
// Pages without a title (e.g. the home page) fall back to the title format with the
// {title} placeholder and any leftover separator removed, then to the site name.
const formattedTitle = plainTitle
  ? site.titleFormat.replace("{title}", plainTitle)
  : site.titleFormat.replace("{title}", "").replace(/^[\s|\-–—:·/•]+|[\s|\-–—:·/•]+$/g, "") ||
    site.name;
const pageDescription = description || site.description;
const pageImage = resolveImageSource(image || site.logoSource);
const canonicalUrl = canonical || Astro.url.href;
const siteUrl = Astro.site || new URL(site.url);
const pageImageUrl = pageImage ? new URL(pageImage, siteUrl).href : undefined;
const keywordContent = keywords?.filter(Boolean).join(", ");
const articleAuthors = Array.isArray(article?.author)
  ? article.author.filter(Boolean)
  : article?.author
    ? [article.author]
    : [];
const articleTags = article?.tags?.filter(Boolean) ?? [];
---

<title data-rosey={roseyTitleKey}>{formattedTitle}</title>
{
  noindex ? (
    <meta
      name="robots"
      content="noindex"
    />
  ) : null
}
<link
  rel="canonical"
  href={canonicalUrl}
/>
<meta
  property="og:type"
  content={pageType}
/>
<meta
  property="og:title"
  content={formattedTitle}
/>
<meta
  property="og:url"
  content={canonicalUrl}
/>
<meta
  property="og:site_name"
  content={site.name}
/>
{
  pageDescription ? (
    <>
      {/* Attribute text, so it needs the explicit form. og:description is left in the
          default language along with the rest of the OG/Twitter tags. */}
      <meta
        name="description"
        content={pageDescription}
        data-rosey-attrs-explicit={
          roseyDescriptionKey ? JSON.stringify({ content: roseyDescriptionKey }) : undefined
        }
      />
      <meta
        property="og:description"
        content={pageDescription}
      />
    </>
  ) : null
}
{
  keywordContent ? (
    <meta
      name="keywords"
      content={keywordContent}
    />
  ) : null
}
{
  pageImageUrl ? (
    <>
      <meta
        property="og:image"
        content={pageImageUrl}
      />
    </>
  ) : null
}
{
  pageType === "article" ? (
    <>
      {article?.publishedTime ? (
        <meta
          property="article:published_time"
          content={article.publishedTime}
        />
      ) : null}
      {article?.modifiedTime ? (
        <meta
          property="article:modified_time"
          content={article.modifiedTime}
        />
      ) : null}
      {articleAuthors.map((author) => (
        <meta
          property="article:author"
          content={author}
        />
      ))}
      {articleTags.map((tag) => (
        <meta
          property="article:tag"
          content={tag}
        />
      ))}
    </>
  ) : null
}
