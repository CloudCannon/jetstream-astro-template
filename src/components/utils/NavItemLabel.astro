---
import Icon from "@core-elements/icon/Icon.astro";

/**
 * Renders the inner content of a navigation row: an optional icon (before or
 * after the text) plus the item name and optional subtext. Falls back to the
 * bare name so rows without extras keep their original, simpler markup.
 */
const { item = {} } = Astro.props;
const { name, iconName, iconPosition = "before", subtext } = item;

const hasIcon = typeof iconName === "string" && iconName.trim().length > 0;
const hasSubtext = typeof subtext === "string" && subtext.trim().length > 0;
const iconAfter = iconPosition === "after";
---

{
  hasIcon || hasSubtext ? (
    <span class:list={["nav-item-label", iconAfter && "icon-after"]}>
      {hasIcon && (
        <span class="nav-item-label-icon">
          <Icon
            name={iconName}
            size="none"
            aria-hidden="true"
          />
        </span>
      )}
      <span class="nav-item-label-text">
        <span class="nav-item-label-name">{name}</span>
        {hasSubtext && <span class="nav-item-label-subtext">{subtext}</span>}
      </span>
    </span>
  ) : (
    name
  )
}

<style is:global>
  @layer components {
    .nav-item-label {
      align-items: flex-start;
      display: flex;
      flex: 1 1 auto;
      gap: var(--spacing-sm);
      min-width: 0;
      text-align: start;

      &.icon-after {
        flex-direction: row-reverse;
        justify-content: flex-end;
      }

      .nav-item-label-icon {
        align-items: center;
        color: var(--color-text-strong);
        display: inline-flex;
        flex: 0 0 auto;
        justify-content: center;
        line-height: 0;
        margin-top: 0.3rem;

        .icon,
        svg {
          height: 1rem;
          width: 1rem;
        }
      }

      .nav-item-label-text {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-xs);
        min-width: 0;
      }

      .nav-item-label-name {
        white-space: nowrap;
      }

      .nav-item-label-subtext {
        color: var(--color-text-muted);
        font-size: var(--font-size-sm);
        font-weight: var(--font-weight-normal);
        line-height: 1.4;
        white-space: normal;
      }
    }

    /* Rows carrying a subtext need to wrap and sit taller than a plain link. */
    .has-label-extras {
      align-items: flex-start;
      white-space: normal;
    }
  }
</style>
