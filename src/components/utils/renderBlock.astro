---
import { pascalToKebab } from "@components/utils/pascalToKebab";
import type { ContentBlock } from "../../types";

export interface Props {
  /**
   * An array renders a list of blocks; a single object renders one block, for
   * inputs that hold exactly one component (e.g. a page's hero or CTA).
   */
  contentSections?: ContentBlock | ContentBlock[] | null;
  useDefaultEditableBinding?: boolean;
  dataProp?: string;
}

type AstroComponent = (_props: Record<string, unknown>) => unknown;

const components: Record<string, AstroComponent> = {};
const componentImports = import.meta.glob("../**/*.{jsx,astro}", {
  eager: true,
});

Object.entries(componentImports).forEach(([path, obj]) => {
  const parts = path.replace("../", "").split(".")[0].split("/");
  const filename = parts[parts.length - 1];

  const kebabFilename = pascalToKebab(filename);

  if (parts.length > 1 && kebabFilename === parts[parts.length - 2]) {
    parts.pop();
    parts[parts.length - 1] = kebabFilename;
  } else {
    parts[parts.length - 1] = kebabFilename;
  }

  const componentName = parts.join("/");

  components[componentName] = (obj as Record<string, AstroComponent>).default;
});

const { contentSections, useDefaultEditableBinding = true, dataProp } = Astro.props;

const isSingleBlock = !!contentSections && !Array.isArray(contentSections);
const blocks: ContentBlock[] = isSingleBlock
  ? [contentSections as ContentBlock]
  : ((contentSections as ContentBlock[]) ?? []);

const editableAttributes = (block: ContentBlock) => {
  if (!useDefaultEditableBinding) return {};

  return isSingleBlock
    ? { "data-editable": "component", "data-component": block._component, "data-prop": dataProp }
    : { "data-editable": "array-item", "data-id": block._component };
};
---

{
  blocks.map((block) => {
    const Component = components[block._component];

    if (!Component && block._component) {
      console.warn(
        `Component not found: ${block._component}. Available components:`,
        Object.keys(components)
      );
    }

    return Component ? (
      <Component
        {...editableAttributes(block)}
        {...block}
        useDefaultEditableBinding={useDefaultEditableBinding}
      />
    ) : null;
  })
}
