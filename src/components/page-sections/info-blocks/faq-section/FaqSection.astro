---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Icon from "@core-elements/icon/Icon.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import Accordion from "@wrappers/accordion/Accordion.astro";

const {
  id = "",
  eyebrowIcon = {},
  eyebrowText = "",
  heading = "Frequently Asked Questions",
  subtext = "",
  items = [],
  singleOpen = true,
  openFirst = false,
  label = "About FAQ",
  sectionLabel,
  maxContentWidth = "xl",
  paddingHorizontal = "lg",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  backgroundColor,
  contentBackground = false,
  background,
  verticalOffset = {},
  rounded = false,
  class: className,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  {...htmlAttributes}
  class:list={["faq-section", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  contentBackground={contentBackground}
  background={background}
  verticalOffset={verticalOffset}
  rounded={rounded}
  id={id}
>
  <Icon
    alignmentHorizontal="center"
    {...eyebrowIcon}
  />
  <SimpleText
    class="eyebrow"
    alignmentHorizontal="center"
    text={eyebrowText}
    data-prop="eyebrowText"
  />
  <Heading
    level="h2"
    size="lg"
    alignmentHorizontal="center"
    text={heading}
    data-prop="heading"
  />
  <Text
    class="faq-section-subtext"
    alignmentHorizontal="center"
    text={subtext}
    data-prop="subtext"
  />

  <Accordion
    label={label}
    singleOpen={singleOpen}
    openFirst={openFirst}
    items={items}
    data-children-prop="items"
  />
</CustomSection>
