---
import CustomSection from "@builders/custom-section/CustomSection.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Icon from "@core-elements/icon/Icon.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import FeatureSliderItem from "@features/feature-slider/FeatureSliderItem.astro";
import Carousel from "@wrappers/carousel/Carousel.astro";

type SlideProps = Record<string, unknown>;

const {
  sectionLabel,
  eyebrowIcon = {},
  eyebrowText = "",
  heading = "",
  subtext = "",
  maxContentWidth = "xl",
  paddingHorizontal = "lg",
  paddingVertical = "4xl",
  colorScheme = "inherit",
  backgroundColor,
  contentBackground = false,
  background,
  verticalOffset = {},
  rounded = false,
  class: className,
  slides = [],
  useDefaultEditableBinding = false,
  _component,
  ...htmlAttributes
} = Astro.props;
---

<CustomSection
  class:list={["feature-slider", className]}
  label={sectionLabel}
  maxContentWidth={maxContentWidth}
  paddingHorizontal={paddingHorizontal}
  paddingVertical={paddingVertical}
  colorScheme={colorScheme}
  backgroundColor={backgroundColor}
  contentBackground={contentBackground}
  background={background}
  verticalOffset={verticalOffset}
  rounded={rounded}
  useDefaultEditableBinding={useDefaultEditableBinding}
  {...htmlAttributes}
>
  <Icon {...eyebrowIcon} />
  <SimpleText
    alignmentHorizontal="start"
    class="eyebrow"
    data-prop="eyebrowText"
    text={eyebrowText}
  />
  <Heading
    level="h2"
    size="lg"
    alignmentHorizontal="start"
    data-prop="heading"
    text={heading}
  />
  <Text
    class="feature-slider-subtext"
    alignmentHorizontal="start"
    data-prop="subtext"
    text={subtext}
  />

  <Carousel
    label="Feature slider"
    slideWidthPercent={100}
    minSlideWidth={0}
    autoPlay={false}
    autoScroll={false}
    data-children-prop="slides"
  >
    {
      slides.map((slide: SlideProps, index: number) => (
        <FeatureSliderItem
          aria-label={`Slide ${index + 1} of ${slides.length}`}
          data-editable="array-item"
          data-id="page-sections/features/feature-slider/feature-slider-item"
          {...slide}
        />
      ))
    }
  </Carousel>
</CustomSection>
