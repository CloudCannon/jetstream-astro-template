---
import BentoBoxGrid from "@wrappers/bento-box-grid/BentoBoxGrid.astro";
import CarouselSlide from "@wrappers/carousel/CarouselSlide.astro";

const {
  cards = [],
  class: className,
  _uuid,
  _component,
  useDefaultEditableBinding = false,
  ...htmlAttributes
} = Astro.props;
---

{/* Namespace stays inside the root, which a re-render copies into the region element. */}
<CarouselSlide {...htmlAttributes}>
  <BentoBoxGrid
    data-rosey-ns={_uuid}
    class:list={["feature-carousel-slide-grid", className]}
    gap="xs"
    items={cards}
    data-children-prop="cards"
  />
</CarouselSlide>

<style is:global>
  @layer page-sections {
    .feature-carousel-slide-grid {
      width: 100%;
      padding: var(--spacing-sm);
    }
  }
</style>
