---
import Heading from "@core-elements/heading/Heading.astro";
import Icon from "@core-elements/icon/Icon.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Text from "@core-elements/text/Text.astro";
import BentoBoxItem from "@wrappers/bento-box/BentoBoxItem.astro";
import Card from "@wrappers/card/Card.astro";

const {
  decorative = false,
  style: backgroundStyle = "surface-linear-gradient",
  eyebrowIcon = {},
  eyebrowText = "",
  heading = "",
  text = "",
  columnSpan,
  rowSpan,
  class: className,
  _component,
  useDefaultEditableBinding = false,
  ...htmlAttributes
} = Astro.props;
---

<BentoBoxItem
  columnSpan={columnSpan}
  rowSpan={rowSpan}
  data-prop-columnSpan="columnSpan"
  data-prop-rowSpan="rowSpan"
  {...htmlAttributes}
>
  <Card
    class:list={["feature-carousel-card", className]}
    paddingHorizontal="lg"
    paddingVertical="lg"
    rounded
    border={!decorative}
    backgroundColor={decorative ? backgroundStyle : "base"}
  >
    {
      !decorative && (
        <Fragment>
          {eyebrowIcon?.name && (
            <Icon
              {...eyebrowIcon}
              alignmentHorizontal="start"
            />
          )}
          {eyebrowText && (
            <SimpleText
              class="eyebrow"
              data-prop="eyebrowText"
            >
              {eyebrowText}
            </SimpleText>
          )}
          {heading && (
            <Heading
              class="feature-slide-heading"
              level="h3"
              size="md"
              alignmentHorizontal="start"
              data-prop="heading"
            >
              {heading}
            </Heading>
          )}
          {text && (
            <Text
              class="feature-slide-text"
              alignmentHorizontal="start"
              data-prop="text"
              text={text}
            />
          )}
        </Fragment>
      )
    }
  </Card>
</BentoBoxItem>

<style is:global>
  @layer page-sections {
    .feature-carousel-card {
      display: flex;
      flex-direction: column;
      height: 100%;
      min-height: 200px;

      /* Card puts `rounded` and `border` on its inner element, not on the
         wrapper this class lands on, so reach through to it. The shadow has to
         sit on that element too — on the wrapper it has no radius to follow and
         squares off the card's rounded corners. Blanking the border there lets
         the ring below read as the border. */
      > .card-inner.border {
        border-color: transparent;
        box-shadow: var(--shadow-raised);
      }

      /* The ring stays on the wrapper: .card-inner clips its own pseudo-elements
         with overflow: hidden. .card-inner is z-index 1, so 0 holds the ring
         behind it — the pattern Card uses for its own hover gradient. */
      &:has(> .card-inner.border)::before {
        --angle: 0deg;
        content: "";
        position: absolute;
        inset: -2px;
        z-index: 0;
        border-radius: calc(var(--radius-md) + 2px);
        background: conic-gradient(
          from var(--angle),
          var(--color-bg-brand),
          var(--color-bg-inverse),
          var(--color-bg-brand)
        );
        animation: rotate-angle 2s linear infinite;
      }

      .card-content {
        display: flex;
        flex-direction: column;
        gap: var(--spacing-sm);
      }

      .eyebrow {
        margin: 0;
        font-size: var(--font-size-sm);
      }

      .feature-slide-heading {
        margin: 0;
      }

      .feature-slide-text {
        margin: 0;
      }
    }
  }
</style>
