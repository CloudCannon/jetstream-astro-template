---
import { mdxComponents } from "@component-utils/mdxComponents";
import RoseyUntagged from "@component-utils/RoseyUntagged.astro";
import { slugifyLabel } from "@component-utils/slugify";
import Button from "@core-elements/button/Button.astro";
import Counter from "@core-elements/counter/Counter.astro";
import Heading from "@core-elements/heading/Heading.astro";
import Image from "@core-elements/image/Image.astro";
import SimpleText from "@core-elements/simple-text/SimpleText.astro";
import Page from "@layouts/Page.astro";
import CustomSection from "@page-sections/builders/custom-section/CustomSection.astro";
import ButtonGroup from "@wrappers/button-group/ButtonGroup.astro";
import Card from "@wrappers/card/Card.astro";
import Split from "@wrappers/split/Split.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

import "@styles/blog-post.css";

export async function getStaticPaths() {
  const posts = await getCollection("blog");

  return posts.map((post: CollectionEntry<"blog">) => {
    const slug = post.id.replace(/\.mdx?$/, "");

    return {
      params: { slug },
      props: { post },
    };
  });
}

interface Props {
  post: CollectionEntry<"blog">;
}

const { post } = Astro.props;
const { Content } = await render(post);
const date = post.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});

// Get three most recent posts excluding the current one
const allPosts = await getCollection("blog");
const recentPosts = allPosts
  .filter((p) => p.id !== post.id)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 3);

// Get author page from uuid
const team = await getCollection("team");
const author = team.find((m: any) => m.data.uuid === post.data.author);

// Build article metadata for Open Graph
const article = {
  publishedTime: post.data.date.toISOString(),
  author: author?.data.name,
  tags: post.data.tag ? [post.data.tag] : undefined,
};
---

<!-- No roseySeo: the head comes from post frontmatter, which stays in the default
     language. hideLocaleSwitcher hides the connector's switcher here, because the post
     body carries no Rosey keys and switching locale would offer nothing to translate. -->
<Page
  title={post.data.title}
  description={post.data.description}
  keywords={post.data.keywords}
  image={post.data.image}
  type="article"
  article={article}
  hideLocaleSwitcher
>
  <CustomSection
    class:list={["hero-feature"]}
    maxContentWidth="2xl"
    paddingHorizontal="lg"
    paddingVertical="4xl"
    colorScheme="inherit"
    backgroundColor="highlight-grid"
    contentBackground="true"
    verticalOffset={{
      size: "nav-height",
      direction: "back",
    }}
  >
    <Split
      distributionMode="half"
      gap="lg"
    >
      <Fragment slot="first">
        {
          /* Post frontmatter is not translated — it belongs to the post file, not to
            Rosey — so these opt out of the derived key. */
        }
        <Heading
          level="h1"
          size="2xl"
          alignmentHorizontal="start"
          class="heading"
          data-prop="title"
          text={post.data.title}
          data-rosey={false}
        />
        {
          /* data-rosey-root escapes the per-post namespace, so "Blog" is one key across
            every post rather than one each. The tag link below sets its own root. */
        }
        <p
          class="breadcrumb"
          data-rosey-root="post"
        >
          <a
            href="/blog/"
            class="blog-link"
            data-rosey="breadcrumb_blog"
            >Blog</a
          > / <a
            href={`/blog/tag/${post.data.tag}`}
            class="tag"
            data-rosey-root="tags"
            ><span
              data-editable="text"
              data-prop="tag"
              data-rosey={slugifyLabel(post.data.tag ?? "")}
              >{post.data.tag}</span
            ></a
          >
        </p>
      </Fragment>
      <Fragment slot="second">
        <SimpleText
          alignmentHorizontal="start"
          class="description"
          data-prop="description"
          data-rosey={false}
        >
          {post.data.description}
        </SimpleText>
        <p class="author">
          By {author?.data.name || "Anonymous"} | {date}
        </p>
      </Fragment>
    </Split>
    <Split
      distributionMode="three-quarters-quarter"
      gap="lg"
    >
      <div
        class="hero-image"
        slot="first"
      >
        <Image
          source={post.data.image}
          alt={post.data.image_alt}
          rounded={true}
          data-prop-src="image"
          data-prop-alt="image_alt"
        />
      </div>
      <div
        class="counters"
        slot="second"
        data-editable="array"
        data-prop="counters"
      >
        {
          post.data?.counters?.map((counter: any, index: number) => (
            <div
              class="counter-container"
              data-editable="array-item"
            >
              {/* Counter values and their labels come from post frontmatter, which is
                  translated in the locale's own content file, so they opt out of the
                  derived keys. */}
              <editable-component
                data-prop="counter"
                data-component="building-blocks/core-elements/counter"
              >
                <Counter
                  {...counter.counter}
                  data-rosey-prefix={false}
                  data-rosey-suffix={false}
                />
              </editable-component>
              <SimpleText
                text={counter.subtext}
                alignmentHorizontal="start"
                data-prop={`subtext`}
                data-rosey={false}
              />
            </div>
          ))
        }
        <template>
          <div class="counter-container">
            <editable-component
              data-prop="counter"
              data-component="building-blocks/core-elements/counter"
            >
              <Counter
                number={0}
                data-rosey-prefix={false}
                data-rosey-suffix={false}
              />
            </editable-component>
            <SimpleText
              text="Counter subtext"
              alignmentHorizontal="start"
              data-prop={`subtext`}
              data-rosey={false}
            />
          </div>
        </template>
      </div>
    </Split>
  </CustomSection>
  <CustomSection
    maxContentWidth="2xl"
    paddingHorizontal="lg"
    paddingVertical="4xl"
    colorScheme="inherit"
    backgroundColor="base"
    class="post-container"
    data-pagefind-filter="Type:Article"
  >
    <Split
      distributionMode="three-quarters-quarter"
      gap="xl"
      class="post-layout"
    >
      <div
        class="post"
        slot="first"
      >
        <editable-text data-prop="@content">
          <RoseyUntagged>
            <Content components={mdxComponents} />
          </RoseyUntagged>
        </editable-text>

        {
          author && (
            <Card
              rounded={true}
              border={false}
              backgroundColor="accent"
              paddingVertical="md"
              paddingHorizontal="md"
              class="author-card"
            >
              <Split
                distributionMode="fixed-flexible"
                fixedWidth="66"
                minSplitWidth="200"
                gap="md"
              >
                <Image
                  slot="first"
                  source={author.data.imageSource}
                  alt={author.data.name}
                  aspectRatio="square"
                  rounded={true}
                  style="border-radius: var(--radius-full);"
                />
                <div slot="second">
                  <Heading
                    level="h3"
                    size="sm"
                    style="margin-bottom: var(--spacing-md); margin-top: 0;"
                  >
                    {author.data.name}
                  </Heading>
                  <SimpleText
                    size="sm"
                    style="margin-top: 0; color: var(--color-text-muted); font-weight: var(--font-weight-bold);"
                  >
                    {author.data.role}
                  </SimpleText>
                </div>
              </Split>
            </Card>
          )
        }

        <div class="share-section">
          {
            /* data-rosey-root escapes the per-post namespace so this is one key for every
              post rather than one per post. */
          }
          <SimpleText
            size="md"
            class="share-section-text"
            style="font-weight: var(--font-weight-bold); margin: 0px;"
            data-editable="source"
            data-path="/src/pages/blog/[...slug].astro"
            data-key="share-section-heading"
            data-rosey-root="post"
            data-rosey="share"
          >
            Share this article:
          </SimpleText>
          <ButtonGroup style="margin: 0px;">
            <Button
              link={`mailto:?subject=${post.data.title.replace(/<[^>]*>/g, "")}&body=Check out this article: ${Astro.url}`}
              variant="secondary"
              size="lg"
              iconName="envelope"
              hideText={true}
              text="Share via Email"
              style="border-radius: var(--radius-full);"
            />
            <Button
              variant="secondary"
              size="lg"
              iconName="link"
              hideText={true}
              text="Copy link"
              class="copy-link-btn"
              style="border-radius: var(--radius-full);"
            />
          </ButtonGroup>
        </div>
      </div>
      <div
        class="sidebar"
        slot="second"
      >
        <SimpleText
          size="sm"
          class="sidebar-title"
          style="border-bottom: 2px solid var(--color-border-subtle); color: var(--color-text-brand); font-weight: var(--font-weight-bold); margin-top: var(--spacing-md);"
          data-editable="source"
          data-path="/src/pages/blog/[...slug].astro"
          data-key="sidebar-heading"
          data-rosey-root="post"
          data-rosey="latest_news"
          >Latest News</SimpleText
        >
        {
          recentPosts.map((recentPost) => {
            const slug = recentPost.id?.replace(/\.mdx?$/, "") || recentPost.slug;
            const postDate = recentPost.data.date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "long",
              day: "numeric",
            });
            const author = team.find((m: any) => m.data.uuid === recentPost.data.author);

            return (
              <Card
                link={`/blog/${slug}`}
                rounded={true}
                border={false}
                backgroundColor="accent"
                paddingVertical="sm"
                paddingHorizontal="sm"
              >
                <Image
                  source={recentPost.data.image}
                  alt={recentPost.data.image_alt}
                  aspectRatio="landscape"
                  rounded={true}
                  style="max-height: 150px; width: 100%;"
                />
                <SimpleText
                  size="xs"
                  style="color: var(--color-text-brand); font-weight: var(--font-weight-bold); margin-bottom: var(--spacing-xs); margin-top: var(--spacing-sm);"
                >
                  {recentPost.data.tag}
                </SimpleText>
                <Heading
                  level="h3"
                  size="xs"
                  style="margin-bottom: var(--spacing-xs); margin-top: 0;"
                  text={recentPost.data.title.replace(/<[^>]*>/g, "")}
                />
                <SimpleText
                  size="sm"
                  style="color: var(--color-text-muted); margin-top: 0; font-weight: var(--font-weight-bold);"
                >
                  By {author?.data.name || "Anonymous"} | {postDate}
                </SimpleText>
              </Card>
            );
          })
        }
      </div>
    </Split>
  </CustomSection>
</Page>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const copyBtn = document.querySelector(".copy-link-btn");
    if (copyBtn) {
      copyBtn.addEventListener("click", () => {
        navigator.clipboard.writeText(window.location.href);
        // Optional: Add visual feedback
        const originalText = copyBtn.getAttribute("data-original-text") || "Copy link";
        copyBtn.setAttribute("data-original-text", originalText);
        // You could add a toast notification here
      });
    }
  });
</script>
